// Ledgerline data model (docs/SYSTEM.md §4).
//
// Money rules:
//   - Money is integer cents. A single input value (one ticket price, one expense)
//     is capped at MAX_CENTS = 1e9 by Zod, so it fits Postgres `integer`
//     (max ≈ 2.1e9). Columns that hold a SUM (settlement lines, the payout) can go
//     above that, so they are `BigInt` (Postgres `bigint`).
//   - Percentages live inside termsJson as basis points; there is no float column.
//
// Tables are added in the phase that first uses them: Contract (PDF) in Phase 3,
// AgentRun/AgentStep/ExpenseFlag in Phase 4, Payout/ProcessedWebhookEvent in Phase 5, ApiKey in Phase 6.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ------------------------------------------------------------------------
// Each enum mirrors a Zod enum in packages/schemas. enums.test.ts fails if the two
// lists drift apart, because the database and the engine must agree on every value.

enum ExpenseCategory {
  production
  advertising
  catering
  security
  staffing
  equipment
  office_supplies
  other
}

enum ExpenseStatus {
  pending
  allowed
  disallowed
}

// Phase 2 states only. approved/paying/paid/payment_failed arrive in Phase 5.
enum SettlementStatus {
  draft
  computed
  in_review
  stale
  approved
  paying
  paid
  payment_failed
}

enum PayoutStatus {
  pending
  processing
  succeeded
  failed
}

enum SettlementLineKind {
  gbor
  ticket_tax
  ticket_fees
  nbor
  expenses_submitted
  expense_disallowed
  expense_category_cap
  expense_total_cap
  allowed_expenses
  guarantee
  net_after_expenses
  percentage_share
  promoter_profit
  split_point
  overage
  deal_payout
  bonus
  total_payout
}

// uploaded → extracting → needs_review → confirmed, or extracting → failed.
// A failed contract is not retried in place: the user uploads the PDF again.
enum ContractStatus {
  uploaded
  extracting
  needs_review
  confirmed
  failed
}

// Audit agent (F6, F12). Mirrors of the Zod enums in packages/schemas/src/agent.ts.
enum AgentRunKind {
  audit
  question
}

enum AgentRunStatus {
  running
  completed
  failed
}

enum AgentOutcome {
  answered
  step_limit
  token_budget
  truncated
  refused
  unexpected_stop
}

enum AgentStepKind {
  model_call
  tool_call
}

enum ExpenseFlagKind {
  category_not_allowed
  over_category_cap
  other
}

enum ExpenseFlagStatus {
  open
  accepted
  dismissed
}

// --- People and places --------------------------------------------------------------

// A human who can confirm terms (and, from Phase 5, approve payouts).
// Login comes later; for now the seed creates one demo user.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  // "scrypt$<salt>$<hash>" (packages/db/src/password.ts), never the password itself.
  // Null = this user cannot log in.
  passwordHash String?
  createdAt    DateTime @default(now())

  confirmedTerms ContractTerms[]
  resolvedFlags  ExpenseFlag[]
  sessions       Session[]
  payouts        Payout[]
  apiKeys        ApiKey[]
}

// A logged-in browser (Phase 5: approval must be tied to a real person). The token
// itself is only ever in the person's cookie; the database keeps its SHA-256, so a
// leaked database row cannot be used to log in.
model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A key for the public /v1 API (F9) and the MCP server (F10). The full key
// ("ll_<prefix>_<secret>") is shown once, when it is created; the database keeps
// only its SHA-256, like Session.tokenHash. A key is not a person: it can read
// settlements and flag expenses, never approve or pay (those routes accept only a
// logged-in session).
model ApiKey {
  id          String    @id @default(uuid())
  name        String // what the person called it, e.g. "Claude Desktop"
  // The 8 characters after "ll_". Not secret: shown in the key list so a person can
  // tell their keys apart. Useless without the secret part.
  prefix      String    @unique
  keyHash     String    @unique
  createdById String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  // Set once, never cleared. The row stays, so the audit log can still say which key
  // did what.
  revokedAt   DateTime?

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([createdById])
}

model Venue {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  shows Show[]
}

model Artist {
  id              String   @id @default(uuid())
  name            String
  // The artist's Stripe connected account (test mode), where payouts are sent.
  // Null until someone creates it from the app.
  stripeAccountId String?  @unique
  createdAt       DateTime @default(now())

  shows Show[]
}

model Show {
  id        String   @id @default(uuid())
  name      String
  showDate  DateTime @db.Date
  venueId   String
  artistId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue       Venue           @relation(fields: [venueId], references: [id])
  artist      Artist          @relation(fields: [artistId], references: [id])
  ticketSales TicketSale[]
  expenses    Expense[]
  contracts   Contract[]
  terms       ContractTerms[]
  settlement  Settlement?

  @@index([venueId])
  @@index([artistId])
}

// --- Inputs: what the engine reads ---------------------------------------------------

// One row per ticket tier. Fields match TicketSaleSchema in packages/schemas.
model TicketSale {
  id         String   @id @default(uuid())
  showId     String
  tierName   String
  qtySold    Int // paid tickets only
  comps      Int // free tickets: counted, but bring in no money
  priceCents Int // face value per ticket
  taxCents   Int // tier total, contained in qtySold × priceCents
  feeCents   Int // tier total, contained in qtySold × priceCents
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  show Show @relation(fields: [showId], references: [id])

  // Two "VIP" rows for the same show would double-count that tier.
  @@unique([showId, tierName])
}

model Expense {
  id          String          @id @default(uuid())
  showId      String
  category    ExpenseCategory
  description String
  amountCents Int
  status      ExpenseStatus   @default(pending)
  // A storage key such as "receipts/<uuid>.pdf", not a full disk path, so the
  // storage backend can change without touching the database.
  receiptKey  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  show  Show          @relation(fields: [showId], references: [id])
  flags ExpenseFlag[]

  @@index([showId])
}

// An uploaded contract PDF and what Claude read from it (F2). The extraction is a
// proposal only: it becomes ContractTerms when a person confirms it (F3), so the
// engine can never compute from terms nobody has checked.
model Contract {
  id             String         @id @default(uuid())
  showId         String
  // A storage key such as "contracts/<uuid>.pdf", like Expense.receiptKey.
  fileKey        String
  fileName       String // as uploaded, for display only (never used as a path)
  status         ContractStatus @default(uploaded)
  // ContractExtraction (packages/schemas), validated with Zod before it is stored
  // and again when it is read. Null until extraction succeeds.
  extractionJson Json?
  promptVersion  String?
  // { model, calls, inputTokens, outputTokens, costNanoUsd } over all attempts.
  llmUsage       Json?
  failureReason  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  show  Show            @relation(fields: [showId], references: [id])
  terms ContractTerms[]

  @@index([showId])
}

// Versioned and never overwritten: an edit creates version n + 1, so a settlement
// always points to the exact terms it was computed from.
//
// Belongs to the show. contractId is set when the version was confirmed from an
// extracted contract, and null when the terms were typed in by hand.
model ContractTerms {
  id            String   @id @default(uuid())
  showId        String
  version       Int
  // The whole ContractTerms object, validated with ContractTermsSchema on every
  // write and read. One JSON column instead of many columns, because the Zod schema
  // is the single definition of the terms' shape (nested deal, caps, bonus tiers).
  termsJson     Json
  // Every version is confirmed by a person: the one who typed the terms in, or the
  // reviewer who checked an extraction. Unreviewed extractions live on Contract.
  confirmedById String
  confirmedAt   DateTime
  contractId    String?
  createdAt     DateTime @default(now())

  show        Show         @relation(fields: [showId], references: [id])
  confirmedBy User         @relation(fields: [confirmedById], references: [id])
  contract    Contract?    @relation(fields: [contractId], references: [id])
  settlements Settlement[]

  @@unique([showId, version])
}

// --- Result ----------------------------------------------------------------------

model Settlement {
  id            String           @id @default(uuid())
  // One settlement per show: the unique index makes it impossible for two
  // concurrent "create" requests to produce two settlements.
  showId        String           @unique
  status        SettlementStatus @default(draft)
  // Increases by one on every compute. Used as an optimistic lock (a compute only
  // saves if the version is still the one it started from) and, in Phase 5, as part
  // of the payout idempotency key.
  version       Int              @default(0)
  // The fields below are null while the settlement is a draft. The state machine
  // guarantees they are set once it has been computed.
  termsId       String?
  // Frozen copy of the exact SettlementInput given to the engine.
  inputSnapshot Json?
  // SHA-256 of the canonical JSON of inputSnapshot. Compared with the hash of the
  // live inputs to detect changes, including ones made directly in the database.
  inputsHash    String?
  engineVersion String?
  payoutCents   BigInt?
  computedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  show      Show             @relation(fields: [showId], references: [id])
  terms     ContractTerms?   @relation(fields: [termsId], references: [id])
  lines     SettlementLine[]
  agentRuns AgentRun[]
  payouts   Payout[]
}

model SettlementLine {
  id           String             @id @default(uuid())
  settlementId String
  position     Int // worksheet order; a table has no order of its own
  kind         SettlementLineKind
  label        String
  amountCents  BigInt // ≥ 0; sums such as the split point can exceed Int
  clauseRef    String?
  // [{ type: "ticket_sale" | "expense", id }]. JSON rather than foreign keys: a line
  // describes the frozen inputSnapshot, and the live row may be edited or deleted later.
  sourceRefs   Json

  settlement Settlement @relation(fields: [settlementId], references: [id])

  @@unique([settlementId, position])
}

// --- Payments (F7) ---------------------------------------------------------------------

// One attempt to send a settlement's payout to the artist (docs/SYSTEM.md §8). It is
// written in the same transaction as the approval, so "approved" and "we intend to
// pay" can never disagree: if the process dies right after, the payout row is
// still there to be picked up.
//
// A retry after a failure is a NEW row (attempt + 1) with a new key: Stripe answers a
// repeated key with the first answer, so reusing a failed attempt's key would only
// repeat the failure.
model Payout {
  id                String       @id @default(uuid())
  settlementId      String
  // The settlement version that was approved; part of the idempotency key.
  settlementVersion Int
  attempt           Int
  amountCents       BigInt
  // "payout:<settlementId>:v<version>:a<attempt>". Sent with every Stripe call for
  // this attempt: a retried call (timeout, crash) cannot create a second transfer.
  idempotencyKey    String       @unique
  status            PayoutStatus @default(pending)
  stripeTransferId  String?      @unique
  failureReason     String?
  // The person who approved (attempt 1) or retried (later attempts).
  createdById       String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  settlement Settlement @relation(fields: [settlementId], references: [id])
  createdBy  User       @relation(fields: [createdById], references: [id])

  // Two requests that both try to create attempt N: the database lets exactly one win.
  @@unique([settlementId, attempt])
}

// Every Stripe webhook event we have handled. Stripe may deliver the same event more
// than once; the event id is the primary key, so the second insert fails and the
// duplicate is ignored. Written in the same transaction as the event's effect.
model ProcessedWebhookEvent {
  id         String   @id // Stripe's event id, "evt_…"
  type       String
  receivedAt DateTime @default(now())
}

// --- Audit agent (F6) and its traces (F12) --------------------------------------------

// One run of the agent loop over one settlement. Together with its steps it is a
// full replay of the conversation: the question is the first user message, and
// the steps are everything that followed, in order.
model AgentRun {
  id                String         @id @default(uuid())
  settlementId      String
  // The settlement version the agent looked at. If the settlement is recomputed
  // later, the run's answers describe the older numbers.
  settlementVersion Int
  kind              AgentRunKind
  question          String // the first user message, exactly as sent
  model             String // as requested; each model_call step stores the one that answered
  promptVersion     String // the system prompt and tool set live in code, versioned
  // "user:<id>": who asked. The agent itself acts as "agent:<runId>" in AuditLog.
  startedBy         String
  status            AgentRunStatus @default(running)
  outcome           AgentOutcome? // set when status = completed
  finalText         String? // set when outcome = answered
  errorMessage      String? // set when status = failed
  // Totals over the model_call steps, added in the same transaction as each step,
  // so they always match the steps (even for a run that crashed halfway).
  inputTokens       Int            @default(0)
  outputTokens      Int            @default(0)
  // Nano-dollars, like Contract.llmUsage. BigInt: a few dollars is already above
  // the Int maximum (2.1e9 nano-dollars ≈ $2.15). NULL = some call had no known
  // price; SQL keeps it NULL from then on, because NULL + x is NULL.
  costNanoUsd       BigInt?        @default(0)
  startedAt         DateTime       @default(now())
  finishedAt        DateTime?

  settlement Settlement    @relation(fields: [settlementId], references: [id])
  steps      AgentStep[]
  flags      ExpenseFlag[]

  @@index([settlementId, startedAt])
}

// One step of a run: a model call or a tool call. One table with columns that
// only one kind uses (instead of two tables), so the whole run reads back in
// order with a single ORDER BY position.
model AgentStep {
  id        String        @id @default(uuid())
  runId     String
  position  Int // 0, 1, 2… in the order things happened
  kind      AgentStepKind
  createdAt DateTime      @default(now())

  // kind = model_call
  model        String? // the model that answered
  stopReason   String?
  // The reply's content blocks exactly as received (text, thinking, tool_use).
  content      Json?
  inputTokens  Int?
  outputTokens Int?
  costNanoUsd  BigInt?
  durationMs   Int?

  // kind = tool_call
  toolUseId  String? // pairs the call with the tool_use block in the step before
  toolName   String?
  toolInput  Json? // as the model sent it, before validation
  toolOutput String? // exactly the text sent back in the tool_result
  isError    Boolean?

  run AgentRun @relation(fields: [runId], references: [id])

  @@unique([runId, position])
}

// The agent's (later also an MCP client's) note that an expense looks wrong. It
// never changes the expense: a person reads it and decides (F6: "the human
// resolves them"), so it does not make the settlement stale either.
model ExpenseFlag {
  id           String            @id @default(uuid())
  // Cascade: a flag about a deleted expense means nothing. The AuditLog keeps
  // both the deleted expense and the flag's creation.
  expenseId    String
  agentRunId   String
  kind         ExpenseFlagKind
  reason       String
  status       ExpenseFlagStatus @default(open)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())

  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  agentRun   AgentRun @relation(fields: [agentRunId], references: [id])
  resolvedBy User?    @relation(fields: [resolvedById], references: [id])

  @@index([expenseId])
  @@index([agentRunId])
}

// --- Audit (F12) ---------------------------------------------------------------------

// Append-only: the code only ever inserts here.
model AuditLog {
  id       String   @id @default(uuid())
  // "user:<id>" or "system"; later "agent:<runId>" and "api_key:<prefix>".
  actor    String
  action   String // e.g. "settlement.computed", "expense.updated"
  entity   String // e.g. "settlement", "expense"
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([entity, entityId, at])
}
