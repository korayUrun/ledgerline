# Copy to .env and fill in. Never commit .env.

# --- Local infrastructure (matches docker-compose.yml) ---
DATABASE_URL=postgresql://ledgerline:ledgerline@localhost:5432/ledgerline
REDIS_URL=redis://localhost:6379
V1_RATE_LIMIT_PER_MINUTE=60

# --- API ---
API_PORT=3001
# Uploaded receipts. Defaults to <repo>/var/storage (gitignored).
# STORAGE_DIR=

# --- Web (Next.js server → API) ---
API_URL=http://localhost:3001

# --- Claude API (Phase 3+). Only the worker reads these. ---
ANTHROPIC_API_KEY=
# "anthropic" (default) calls Claude. "fake" runs without a key: every contract
# comes back with all fields missing, and you type the terms in the review screen.
# LLM_CLIENT=anthropic
# EXTRACTION_MODEL=claude-opus-5-5
# LLM_TIMEOUT_MS=120000
# LLM_MAX_RETRIES=3

# --- Stripe: TEST MODE ONLY. Keys must start with sk_test_ / whsec_ ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
